# Cloudflare Pages headers (copied into the export by public/).
# Content-hashed Next assets and the card/banner art are immutable per URL:
# cache hard so repeat visits don't revalidate 200+ images (each revalidation
# round-trip was stealing scroll bandwidth on the artifact grids).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/cards/*
  Cache-Control: public, max-age=2592000, immutable

/banners/*
  Cache-Control: public, max-age=2592000, immutable

/og-image.png
  Cache-Control: public, max-age=86400
